# user.cmake - project customisation included by the generated
# CMakeLists.txt AFTER the generated build is set up.  This file is NOT
# regenerated by MCC, so custom sources belong here (not in .generated/).
#
# Adds the nInvaders game + its bare-metal port layer to the build.
#
# We append to the stable object-library target created in rule.cmake,
# "same54_blinky_default_default_XC32_compile" (its name has no volatile
# suffix, unlike the final image target).  Sources added via target_sources
# and include dirs via target_include_directories are picked up by that
# object library, which is already linked into the final image.

set(APP_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../..")
set(NINV_DIR "${APP_ROOT}/ninvaders")
set(PORT_DIR "${APP_ROOT}/ninvaders_port")

set(NINVADERS_SOURCES
    "${NINV_DIR}/nInvaders.c"
    "${NINV_DIR}/aliens.c"
    "${NINV_DIR}/player.c"
    "${NINV_DIR}/ufo.c"
    "${NINV_DIR}/globals.c"
    "${NINV_DIR}/highscore.c"
    "${NINV_DIR}/view.c"
    "${PORT_DIR}/ncurses_shim.c"
    "${PORT_DIR}/port_system.c"
    "${PORT_DIR}/compat.c")

target_sources(same54_blinky_default_default_XC32_compile
    PRIVATE ${NINVADERS_SOURCES})

target_include_directories(same54_blinky_default_default_XC32_compile
    PRIVATE "${PORT_DIR}/include"
    PRIVATE "${NINV_DIR}")

# nInvaders defines int main(); rename it to ninvaders_main at compile time
# so the framework's src/main.c remains the real entry point.  This keeps
# the upstream nInvaders sources byte-for-byte unmodified.
set_source_files_properties("${NINV_DIR}/nInvaders.c"
    PROPERTIES COMPILE_DEFINITIONS "main=ninvaders_main")
